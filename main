local function createCustomGui(message1, showMessage3, ...)
    local Lighting = game:GetService("Lighting")
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local existingBlur = Lighting:FindFirstChild("ScreenBlur")
    if existingBlur then existingBlur:Destroy() end
    local existingGui = playerGui:FindFirstChild("ScreenDarken")
    if existingGui then existingGui:Destroy() end

    local blur = Instance.new("BlurEffect")
    blur.Name = "ScreenBlur"
    blur.Size = 24
    blur.Parent = Lighting

    local darkenGui = Instance.new("ScreenGui")
    darkenGui.Name = "ScreenDarken"
    darkenGui.IgnoreGuiInset = true
    darkenGui.ResetOnSpawn = false
    darkenGui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.Position = UDim2.new(0, 0, 0, 0)
    frame.BackgroundColor3 = Color3.new(0, 0, 0)
    frame.BackgroundTransparency = 0.5
    frame.Parent = darkenGui

    if getgenv().auto_win == true or getgenv().auto_bond == true then
        local image = Instance.new("ImageLabel")
        image.Name = "CenterImage"
        image.Size = UDim2.new(1, 0, 1, 0)
        image.Position = UDim2.new(0, 0, 0, 0)
        image.BackgroundTransparency = 1
        image.Image = "rbxassetid://88747718358978"
        image.ImageTransparency = 0.3
        image.ZIndex = 2
        image.Parent = frame

        local copyButton = Instance.new("TextButton")
        copyButton.Size = UDim2.new(0, 190, 0, 40)
        copyButton.Position = UDim2.new(0.5, -95, 0.545, 0)
        copyButton.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        copyButton.TextColor3 = Color3.new(1, 1, 1)
        copyButton.Text = "Copy Discord"
        copyButton.TextSize = 3
        copyButton.Font = Enum.Font.GothamBold
        copyButton.TextScaled = true
        copyButton.AutoButtonColor = true
        copyButton.ZIndex = 2
        copyButton.Parent = frame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = copyButton

        local constraint = Instance.new("UITextSizeConstraint")
        constraint.MaxTextSize = 28
        constraint.MinTextSize = 10
        constraint.Parent = copyButton

        copyButton.MouseButton1Click:Connect(function()
            setclipboard("https://discord.gg/moondiety")
            copyButton.Text = "Copied!"
            task.delay(2, function()
                copyButton.Text = "Copy Discord"
            end)
        end)
    end

    local function applyStaticGradient(label)
        local gradient = Instance.new("UIGradient")
        gradient.Rotation = 6
        if getgenv().auto_win == true or getgenv().auto_bond == true then
            gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.new(1, 1, 1)),
                ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 120, 120)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.75, Color3.fromRGB(255, 120, 120)),
                ColorSequenceKeypoint.new(1.00, Color3.new(1, 1, 1)),
            })
        elseif getgenv().autowin == true or getgenv().autobond == true then
            gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.new(1, 1, 1)),
                ColorSequenceKeypoint.new(0.25, Color3.fromRGB(90, 225, 180)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(7, 175, 118)),
                ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 225, 180)),
                ColorSequenceKeypoint.new(1.00, Color3.new(1, 1, 1)),
            })
        end
        gradient.Parent = label
    end

    local function createText(yScale, heightScale)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, heightScale, 0)
        label.Position = UDim2.new(0, 0, yScale, 0)
        label.BackgroundTransparency = 1
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = Color3.new(1, 1, 1)
        label.ZIndex = 2
        label.Parent = frame

        local constraint = Instance.new("UITextSizeConstraint")
        constraint.MaxTextSize = 40
        constraint.MinTextSize = 10
        constraint.Parent = label

        return label
    end

    local line1 = createText(0.43, 0.035)
    line1.RichText = true
    line1.Text = message1

    local animatedText = createText(0.495, 0.028)
    animatedText.Text = ""
    animatedText.RichText = true
    applyStaticGradient(animatedText)

    local timeText = createText(0.465, 0.028)
    applyStaticGradient(timeText)

    local totalSeconds = 14 * 60
    task.spawn(function()
        while totalSeconds >= 0 do
            local minutes = math.floor(totalSeconds / 60)
            local seconds = totalSeconds % 60
            timeText.Text = string.format("Time Remain: %02d:%02d", minutes, seconds)
            task.wait(1)
            totalSeconds -= 1
        end
        timeText.Text = "Time Remain: 00:00"
    end)

    local messages = {...}
    if #messages == 0 then
        messages = {"Default message"}
    end

    task.spawn(function()
        local i = 1
        while true do
            local fullText = tostring(messages[i] or "")
            animatedText.Text = ""
            task.wait()
            for j = 1, #fullText do
                animatedText.Text = fullText:sub(1, j)
                task.wait(0.05)
            end
            task.wait(2)
            i = (i % #messages) + 1
        end
    end)

    if not showMessage3 then
        timeText.Visible = false
        animatedText.Position = UDim2.new(0, 0, 0.465, 0)
    end

    return line1, animatedText, timeText
end

local line1, animatedText, timeText
local function PartyTeleport()
task.delay(15, function()

    local Player = game.Players.LocalPlayer    
    local Http = game:GetService("HttpService")
    local TPS = game:GetService("TeleportService")
    local Api = "https://games.roblox.com/v1/games/"

    local _place,_id = game.PlaceId, game.JobId
    local _servers = Api.._place.."/servers/Public?sortOrder=Asc&limit=10"

    function ListServers(cursor)
        local Raw = game:HttpGet(_servers .. ((cursor and "&cursor="..cursor) or ""))
        return Http:JSONDecode(Raw)
    end

    time_to_wait = 1

    while task.wait(time_to_wait) do
        Player.Character.HumanoidRootPart.Anchored = true
        local Servers = ListServers()
        local Server = Servers.data[math.random(1,#Servers.data)]
        TPS:TeleportToPlaceInstance(_place, Server.id, Player)
    end

end)

    local TweenService = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunService = game:GetService("RunService")
    local TeleportService = game:GetService("TeleportService")

    local player = Players.LocalPlayer
    local connection

    local function getCharacter()
        return player.Character or player.CharacterAdded:Wait()
    end

    local function getHumanoidRootPart()
        return getCharacter():WaitForChild("HumanoidRootPart")
    end

    local function getHumanoid()
        return getCharacter():WaitForChild("Humanoid")
    end

    local function getStatusLabel(zone)
        return zone:FindFirstChild("BillboardGui") and zone.BillboardGui:FindFirstChild("StatusLabel")
    end

    local function findAvailableTeleportZone()
        local zones = workspace:WaitForChild("PartyZones")
        for i = 0, 3 do
            local zoneName = i == 0 and "PartyZone" or "PartyZone"..i
            local zone = zones:FindFirstChild(zoneName)
            if zone then
                local label = getStatusLabel(zone)
                if label and label.Text == "Waiting for players..." and zone.PrimaryPart then
                    return zone
                end
            end
        end
        return nil
    end

    local function teleportToTop(destination)
        local root = getHumanoidRootPart()
        if root and destination then
            if root.Anchored then root.Anchored = false end
            local topPosition = destination.Position + Vector3.new(0, destination.Size.Y/2 + 3, 0)
            root.CFrame = CFrame.new(topPosition)
        end
    end


    local function walkAroundPosition(centerCFrame, radius, duration, angularSpeed)
        local character = getCharacter()
        local root = character:WaitForChild("HumanoidRootPart")
        local humanoid = character:WaitForChild("Humanoid")
        local startTime = tick()
        local angle = 0

        task.spawn(function()
            while tick() - startTime < duration do
                local targetX = centerCFrame.Position.X + math.cos(angle) * radius
                local targetZ = centerCFrame.Position.Z + math.sin(angle) * radius
                local targetPos = Vector3.new(targetX, root.Position.Y, targetZ)
                humanoid:MoveTo(targetPos)
                humanoid.MoveToFinished:Wait(0.03)
                angle = angle + angularSpeed
                task.wait(0.02)
            end
        end)
    end

    local lastCheck = 0
    local currentZone = nil
    local zoneLocked = false
    local partyRequestTime = nil
 task.spawn(function()
 while task.wait(1) do

            if not zoneLocked then
                local zone = findAvailableTeleportZone()
                if zone then

                    teleportToTop(zone.PrimaryPart)
                    currentZone = zone
                    zoneLocked = true
                    
                    task.spawn(function()
                        while task.wait(1) do
                            local label = getStatusLabel(currentZone)
                            if label and label.Text == "Creating Party" then
                            local args = {
                                        {
                                            isPrivate = false,
                                            maxMembers = getgenv().party_members or 1,
                                            trainId = "default",
                                            gameMode = getgenv().party_mode or "Normal"
                                        }
                                    }
                                    ReplicatedStorage.Shared.Universe.Network.RemoteEvent.CreateParty:FireServer(unpack(args))
                                print('attempt')
                            end
                        end
                        walkAroundPosition(zone.PrimaryPart.CFrame, 3, 10, 0.015)
                    end)

                end
            elseif currentZone then
                local label = getStatusLabel(currentZone)
                if label and label.Text == "Waiting for players..." then
                    zoneLocked = false
                    currentZone = nil
                    partyRequestTime = nil
                end
            end

end
end)
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local humanoid = char:WaitForChild("Humanoid")
local root = char:WaitForChild("HumanoidRootPart")

local FLYING = false
local CONTROL = {Q = 0, E = 0}
local bg, bv
local renderConn

local function startFly()
    if FLYING then return end
    bg = Instance.new("BodyGyro", root)
    bv = Instance.new("BodyVelocity", root)
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = root.CFrame
    bv.velocity = Vector3.new()
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    FLYING = true

    UserInputService.InputBegan:Connect(function(i, g)
        if g then return end
        local k = i.KeyCode.Name:lower()
    end)
    UserInputService.InputEnded:Connect(function(i, g)
        if g then return end
        local k = i.KeyCode.Name:lower()
    end)

    renderConn = RunService.RenderStepped:Connect(function()
        if FLYING then
            local speed = getgenv().vflyspeed or 10
            local camCF = workspace.CurrentCamera.CFrame
            local moveDir = humanoid and humanoid.MoveDirection or Vector3.new()
            local vertical = CONTROL.E + CONTROL.Q
            local camLook = camCF.LookVector
            local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
            if camRight.Magnitude > 0 then camRight = camRight.Unit end
            local f = moveDir:Dot(camLook.Unit)
            local r = moveDir:Dot(camRight)
            local dir = (camLook.Unit * f) + (camRight * r)
            if vertical ~= 0 then dir = dir + Vector3.new(0, vertical, 0) end
            if dir.Magnitude > 0 then dir = dir.Unit end
            bv.Velocity = dir * speed
            bg.CFrame = camCF
        end
    end)
end

local function stopFly()
    FLYING = false
    if bg then bg:Destroy() bg = nil end
    if bv then bv:Destroy() bv = nil end
    if renderConn then renderConn:Disconnect() renderConn = nil end
end
local player = game.Players.LocalPlayer
local FLYING = false
local flyActive = false

local state = {
    crateOpened = false,
    horseMounted = false
}

local lastCrateId = nil
local horse = nil
local draggedSaddleId = nil


local remoteStore = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
    :WaitForChild("Universe"):WaitForChild("Network")
    :WaitForChild("RemoteEvent"):WaitForChild("Store")

local startDragRemote = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
    :WaitForChild("Universe"):WaitForChild("Network")
    :WaitForChild("RemoteEvent"):WaitForChild("StartDrag")

local stopDragRemote = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
    :WaitForChild("Universe"):WaitForChild("Network")
    :WaitForChild("RemoteEvent"):WaitForChild("StopDrag")



task.spawn(function()
    while true do
        task.wait(0.2)
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if humanoid.SeatPart == nil then
                local t = tick()
                while tick() - t < 0.5 do
                    task.wait()
                    if humanoid.SeatPart ~= nil then
                        break
                    end
                end
                if humanoid.SeatPart == nil then
                    if FLYING then
                        stopFly()
                    end
                end
            end
        end
    end
end)
local flyActive = false
local flyTask = nil
local horse = nil
local draggedSaddleId = nil
local lastCrateId = nil
local FLYING = false

local function pullHorseForward(horse, rootPart)
    if not horse or not rootPart then
        return
    end
    local look = rootPart.CFrame.LookVector
    local targetPos = rootPart.Position + (look * 9)
    horse:PivotTo(CFrame.new(targetPos))
end
local function findHorse(rootPart)
    if not rootPart then
        return nil, nil
    end

    local closestHorse = nil
    local minDist = math.huge
    local closestSaddle = nil

    local function searchHorseInContainer(container, checkDisabled)
        if container then
            local horse = container:FindFirstChild("Model_Horse")
            if horse then
                local seat = horse:FindFirstChild("VehicleSeat")
                if seat then
                    -- Если checkDisabled = true, ищем только с Disabled == true
                    -- Если checkDisabled = false, ищем только с Disabled == false
                    local condition = checkDisabled and seat.Disabled or not seat.Disabled
                    if condition then
                        local dist = (seat.Position - rootPart.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closestHorse = horse
                        end
                    end
                end
            end
        end
    end

    -- Сначала ищем активные лошади (без седла, Disabled = false)
    searchHorseInContainer(workspace, false)
    local runtimeEntities = workspace:FindFirstChild("RuntimeEntities")
    if runtimeEntities then
        searchHorseInContainer(runtimeEntities, false)
    end

    if not closestHorse then
        local RS = game:GetService("ReplicatedStorage")
        local target = Vector3.new(136.646164, 4.78174829, 29815.7168)

        local function distXZ(a, b)
            return ((a.X-b.X)^2 + (a.Z-b.Z)^2)^0.5
        end

        local function check(obj)
            if not obj or obj.Name ~= "saddle" then return end

            local p = obj:FindFirstChild("MeshPart")
            if not p then return end

            if distXZ(p.Position, target) < 25 then
                obj.Parent = RS
                return nil
            end

            return obj
        end

        -- Очищаем старые седла из ReplicatedStorage перед поиском
        for _, v in ipairs(RS:GetChildren()) do
            if v.Name == "saddle" then
                v:Destroy()
            end
        end

        local saddle = check(workspace.ObjectModels:FindFirstChild("saddle"))

        if saddle then
            print("FOUND SADDLE:", saddle)
            local saddlePos = saddle:GetPivot().Position

            -- Заново ищем ближайшую лошадь, НО ТОЛЬКО с выключенным сиденьем (Disabled = true)
            local horseMinDist = math.huge
            local horseFound = nil
            
            local function searchHorseWithSaddle(container)
                if container then
                    local horse = container:FindFirstChild("Model_Horse")
                    if horse then
                        local seat = horse:FindFirstChild("VehicleSeat")
                        if seat and seat.Disabled then -- Только лошади с седлом
                            local dist = (seat.Position - saddlePos).Magnitude
                            if dist < horseMinDist then
                                horseMinDist = dist
                                horseFound = horse
                            end
                        end
                    end
                end
            end

            searchHorseWithSaddle(workspace)
            if runtimeEntities then
                searchHorseWithSaddle(runtimeEntities)
            end

            if horseFound then
                closestHorse = horseFound
                closestSaddle = saddle
            end
        end
    end

    return closestHorse, closestSaddle
end

local function openFly()
    if flyActive then
        return
    end
    flyActive = true
    state.crateOpened = false
    state.horseMounted = false
    horse = nil
    lastCrateId = nil
    draggedSaddleId = nil

    flyTask = task.spawn(function()
        while flyActive do
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local objectModels = workspace:FindFirstChild("ObjectModels")
            if not rootPart or not humanoid then
                task.wait(0.3)
                continue
            end

            local closestHorse, closestSaddle = findHorse(rootPart)
            local closestCrate, minDist = nil, math.huge
            if objectModels then
                for _, obj in ipairs(objectModels:GetChildren()) do
                    if obj.Name == "crate" then
                        local dist = (obj:GetPivot().Position - rootPart.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closestCrate = obj
                        end
                    end
                end
            end
            if closestCrate and not state.crateOpened then
                local id = closestCrate:GetAttribute("serverEntity")
                if id and id ~= lastCrateId then
                    lastCrateId = id
                    local remote = game:GetService("ReplicatedStorage")
                        :WaitForChild("Shared"):WaitForChild("Universe")
                        :WaitForChild("Network"):WaitForChild("RemoteEvent")
                        :WaitForChild("Actionable")
                    remote:FireServer(id)
                    task.wait(0.1)
                    remote:FireServer(id)
                    state.crateOpened = true
                    task.wait(0.5)
                    closestHorse, closestSaddle = findHorse(rootPart)
                    draggedSaddleId = nil
                end
            end

            if closestHorse and closestHorse.Parent then
                local seat = closestHorse:FindFirstChild("VehicleSeat")
                if seat and seat.Disabled == false then
                    task.wait(0.1)
                    if not state.horseMounted then
                        rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
                        state.horseMounted = true

                        if not FLYING then
                            FLYING = true
                        end
                        local horseID = closestHorse:GetAttribute("serverEntity")
                        if horseID then
                            remoteStore:FireServer(horseID)
                            startFly()
                        end
                    end
                elseif closestSaddle then
                    pullHorseForward(closestHorse, rootPart)
                    local saddleID = closestSaddle:GetAttribute("serverEntity")
                    if saddleID and saddleID ~= draggedSaddleId then
                        draggedSaddleId = saddleID
                        startDragRemote:FireServer(saddleID)
                        local startTime = tick()
                        local maxWait = 5
                        while flyActive do
                            task.wait(0.1)
                            local stillExists = false
                            for _, obj in ipairs(objectModels:GetChildren()) do
                                if obj.Name == "saddle" and obj:GetAttribute("serverEntity") == saddleID then
                                    stillExists = true
                                    break
                                end
                            end
                            if not stillExists then break end
                            if closestHorse and closestHorse.Parent then
                                pullHorseForward(closestHorse, rootPart)
                            end
                            if tick() - startTime > maxWait then break end
                        end
                        stopDragRemote:FireServer(saddleID)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

local function closeFly()
    if not flyActive then return end
    flyActive = false
    stopFly()
    if flyTask then
        task.wait(0.1)
        flyTask = nil
    end
    for i = 1, 10 do
        game:GetService("ReplicatedStorage")
            :WaitForChild("Shared"):WaitForChild("Universe")
            :WaitForChild("Network"):WaitForChild("RemoteEvent")
            :WaitForChild("Store"):FireServer()
        task.wait(0.05)
    end
end

local function autoBonds()
    local p = game.Players.LocalPlayer

getgenv().timer = true

task.spawn(function()
    local p = game.Players.LocalPlayer

    while getgenv().timer do
        local c = p.Character or p.CharacterAdded:Wait()
        local hrp = c:WaitForChild("HumanoidRootPart")
        local humanoid = c:WaitForChild("Humanoid")

        local lastPos = hrp.Position
        local afkTime = 0
        local totalTime = 0

        while c.Parent and getgenv().timer do
            task.wait(1)

            totalTime += 1

            if (hrp.Position - lastPos).Magnitude < 0.5 then
                afkTime += 1
            else
                afkTime = 0
                lastPos = hrp.Position
            end

            if afkTime >= 15 then
                game:GetService("ReplicatedStorage").Remotes.ReturnToLooby:FireServer()
                break
            end

            if totalTime >= 50 then
                 game:GetService("ReplicatedStorage").Remotes.ReturnToLooby:FireServer()
                break
            end
        end
    end
end)

      local player = game.Players.LocalPlayer
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local startPos = hrp.CFrame + Vector3.new(0, 3, 0)

    if not flyActive then
        openFly()
    end

    while not (state.horseMounted and FLYING) do
        task.wait(0.2)
    end

local startPos = Vector3.new(64, 41, 29731)
local endPos = Vector3.new(-50.918488, 48.4707794, -48867.3633)
local vampireCastleDistance = 500

local targetNames = {"FortConstitution","Sterling","RandomBuildings.BankDestroyed"}

local players = game:GetService("Players")
local runService = game:GetService("RunService")
local player = players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local foundObjects = {}
local isTeleporting = false
local startTime = nil
local specialPointsTriggered = false
local totalBondsCollected = 0
local firedBonds = {}

local remote = game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Universe"):WaitForChild("Network"):WaitForChild("RemoteEvent"):WaitForChild("Actionable")

local function getObjectCenter(obj)
    if obj:IsA("BasePart") then return obj.Position
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        return obj:GetPivot().Position
    end
    return obj.Position
end

local function collectAllBonds()
    local bonds = workspace:FindFirstChild("ObjectModels")
    if not bonds then return false end
    
    local anyLeft = false
    for _, obj in ipairs(bonds:GetChildren()) do
        if obj.Name == "bond" and not firedBonds[obj] then
            anyLeft = true
            local id = obj:GetAttribute("serverEntity")
            if id then
                remote:FireServer(id)
                totalBondsCollected = totalBondsCollected + 1
                firedBonds[obj] = true
                task.wait(0.05)
            end
        end
    end
    return anyLeft
end

local function waitForAllBonds()
    while true do
        collectAllBonds()
        
        local bonds = workspace:FindFirstChild("ObjectModels")
        local remaining = 0
        if bonds then
            for _, obj in ipairs(bonds:GetChildren()) do
                if obj.Name == "bond" and not firedBonds[obj] then
                    remaining = remaining + 1
                end
            end
        end
        
        if remaining == 0 then
            break
        end
        
        task.wait(0.3)
    end
end

local function teleportToPosition(pos, yOffset)
    isTeleporting = true
    
    humanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, yOffset or 10, 0))
    
    task.wait(.5)
    waitForAllBonds()
    
    local bonds = workspace:FindFirstChild("ObjectModels")
    local hadBonds = false
    if bonds then
        for _, obj in ipairs(bonds:GetChildren()) do
            if obj.Name == "bond" then
                hadBonds = true
                break
            end
        end
    end
    
    if not hadBonds then
        task.wait(0.2)
    else
        task.wait(0.2)
    end
    
    isTeleporting = false
end

local function teleportToPositionFast(pos, yOffset)
    isTeleporting = true
    
    humanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, yOffset or 10, 0))
    
    task.wait(0.1)
    waitForAllBonds()
    
    local bonds = workspace:FindFirstChild("ObjectModels")
    local hadBonds = false
    if bonds then
        for _, obj in ipairs(bonds:GetChildren()) do
            if obj.Name == "bond" then
                hadBonds = true
                break
            end
        end
    end
    
    if not hadBonds then
        task.wait(0.25)
    else
        task.wait(0.15)
    end
    
    isTeleporting = false
end

local function teleportToCenter(obj)
    teleportToPosition(getObjectCenter(obj), 10)
end

local function teleportToBankFast(bank)
    local pos
    if bank:IsA("Model") then
        pos = bank.PrimaryPart and bank.PrimaryPart.Position or bank:GetPivot().Position
    else
        pos = bank.Position
    end
    teleportToPositionFast(pos, 30)
end

local function getBanks()
    local banks = {}
    local function scan(parent)
        for _, v in ipairs(parent:GetChildren()) do
            if v.Name == "Bank" or v.Name == "BankDestroyed" then
                table.insert(banks, v)
            end
            scan(v)
        end
    end
    scan(workspace)
    return banks
end

local function processFoundObject(obj)
    if isTeleporting then return end
    
    teleportToCenter(obj)
    
    if obj.Name == "Sterling" then
        local bank = workspace:FindFirstChild("Sterling"):FindFirstChild("Town"):FindFirstChild("Buildings"):FindFirstChild("Bank")
        if bank then
            teleportToBankFast(bank)
        end
        local moveWall = workspace:FindFirstChild("Sterling"):FindFirstChild("Mountain"):FindFirstChild("TabletPodium"):FindFirstChild("MoveWall")
        if moveWall then
            teleportToCenter(moveWall)
        end
    elseif obj.Name == "FortConstitution" then
        local supplyDepot = workspace:FindFirstChild("FortConstitution"):FindFirstChild("SupplyDepot")
        if supplyDepot then
            teleportToCenter(supplyDepot)
        end
    end
end

local function checkMainTargets()
    for _, name in ipairs(targetNames) do
        if not foundObjects[name] then
            local target = workspace:FindFirstChild(name)
            if target then
                local dist = (getObjectCenter(target) - humanoidRootPart.Position).Magnitude
                if dist < 2000 then
                    foundObjects[name] = target
                    task.spawn(function() processFoundObject(target) end)
                    task.wait(0.2)
                end
            end
        end
    end
end

local function checkTowns()
    local towns = workspace:FindFirstChild("Towns")
    if not towns then return end
    
    for _, folder in ipairs(towns:GetChildren()) do
        if string.sub(folder.Name, 1, 5) == "town_" then
            local key = "Towns_" .. folder.Name
            if not foundObjects[key] then
                local dist = (getObjectCenter(folder) - humanoidRootPart.Position).Magnitude
                if dist < 3000 then
                    foundObjects[key] = folder
                    
                    task.spawn(function() 
                        processFoundObject(folder)
                        
                        local banks = getBanks()
                        for _, bank in ipairs(banks) do
                            local bankPos = bank:IsA("Model") and (bank.PrimaryPart and bank.PrimaryPart.Position or bank:GetPivot().Position) or bank.Position
                            if (bankPos - getObjectCenter(folder)).Magnitude < 500 then
                                teleportToBankFast(bank)
                                task.wait(0.2)
                            end
                        end
                    end)
                    
                    task.wait(0.1)
                end
            end
        end
    end
end

local function checkVampireCastle()
    local castle = workspace:FindFirstChild("VampireCastle")
    if castle and not foundObjects.VampireCastle then
        local dist = (getObjectCenter(castle) - humanoidRootPart.Position).Magnitude
        if dist < vampireCastleDistance then
            foundObjects.VampireCastle = castle
            task.spawn(function() processFoundObject(castle) end)
        end
    end
end

local function checkSpecialZone()
    local pos = humanoidRootPart.Position
    if not specialPointsTriggered and pos.Z < -47600 then
        specialPointsTriggered = true
        local points = {Vector3.new(-258,12,-47644), Vector3.new(10,12,-47647)}
        for _, p in ipairs(points) do
            teleportToPosition(p, 0)
            task.wait(.3)
        end
    end
end

local function fly()
    startTime = tick()
    
    humanoidRootPart.CFrame = CFrame.new(startPos)
    task.wait(0.1)
    
    while (humanoidRootPart.Position - endPos).Magnitude > 50 do
        if isTeleporting then 
            task.wait(0.1) 
            continue 
        end
        
        local dir = (endPos - humanoidRootPart.Position).unit
        local step = dir * 5000 * runService.RenderStepped:Wait()
        local newPos = humanoidRootPart.Position + step
        humanoidRootPart.CFrame = CFrame.new(newPos)
        
        checkMainTargets()
        checkTowns()
        checkVampireCastle()
        checkSpecialZone()
    end
    
    teleportToPosition(endPos, 0)
    local finalUp = endPos + Vector3.new(0, 200, 0)
    teleportToPosition(finalUp, 0)
    
    local totalTime = tick() - startTime
    
    print("\n" .. string.rep("=", 60))
    print("FLIGHT RESULTS")
    print(string.rep("=", 60))
    print(string.format("Time: %.2f sec", totalTime))
    for name,_ in pairs(foundObjects) do
        print(string.format("  ✅ %s", name))
    end
    print(string.format("Bonds collected: %d", totalBondsCollected))
   
    print(string.rep("=", 60))

