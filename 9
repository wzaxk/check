local function dispatchCommand(targets, cmdType, payload)
    local code = buildExecCode(cmdType, payload)
    if code == "" then return end
    if targets ~= nil and #targets == 0 then return end

    task.spawn(function()
        local body = {
            hwid = currentHwid(), type = "exec_code",
            payload = { code = code },
            gameId = gameIdStr, placeId = placeIdStr,
        }
        if targets == nil then
            local list = getUsersCached()
            if #list == 0 then
                list = getUsersFresh()
            end
            local ids = {}
            for _, p in ipairs(list) do
                local pId = p.id
                if pId then
                    table.insert(ids, pId)
                end
            end
            if #ids == 0 then return end
            body.targets = ids
        else
            body.targets = targets
        end
        body.all = false
        adminHttpPost(SERVER_URL .. "/cmd", body)
    end)
end

local function dispatchRawCode(targets, code)
    if not code or code == "" then return end
    if not targets or #targets == 0 then return end
    task.spawn(function()
        local body = {
            hwid = currentHwid(), type = "exec_code",
            payload = { code = code },
            gameId = gameIdStr, placeId = placeIdStr,
            targets = targets, all = false,
        }
        adminHttpPost(SERVER_URL .. "/cmd", body)
    end)
end

