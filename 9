    end
    remoteControl.connections = {}

    if specConn then
        pcall(function() specConn:Disconnect() end)
        specConn = nil
    end

    if remoteControl.active and remoteControl.targets then
        if not remoteControl.spectateOnly then
            dispatchRawCode(remoteControl.targets, buildFMCDeactivateCode())
        end
        if not remoteControl.cameraRestored then
            dispatchRawCode(remoteControl.targets, buildCameraRestoreCode())
            remoteControl.cameraRestored = true
        end
    end

    remoteControl.active = false
    remoteControl.spectateOnly = false
    remoteControl.targets = nil
    remoteControl.targetPlayer = nil
    remoteControl.camSeq = 0
