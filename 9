local function filterUsers(query, source)
    local list = getUsersCached()
    if source == "server" then
        local myJob = game.JobId
        local filtered = {}
        for _, p in ipairs(list) do
            local pid = tostring(p.id or "")
            local pJob = pid:match("^([^:]+)") or tostring(p.jobId or "")
            if pJob == myJob then table.insert(filtered, p) end
        end
        list = filtered
    end
    local q = string.lower(query or "")
    if q == "" then return list end
    local out = {}
    for _, p in ipairs(list) do
        local uid = tonumber(p.userId)
        local fallback = uid and usernameFallbackCache[uid]
        local n  = string.lower(tostring(p.name or ""))
        local un = string.lower(tostring(p.username or p.user_name or ""))
        local d  = string.lower(tostring(p.displayName or p.display_name or ""))
        local u  = string.lower(tostring(p.userId or ""))
        local gn = string.lower(tostring(p.gameName or ""))
        local fb = string.lower(tostring(fallback or ""))
        if string.find(n, q, 1, true) or string.find(un, q, 1, true)
            or string.find(d, q, 1, true) or string.find(u, q, 1, true)
            or string.find(gn, q, 1, true) or string.find(fb, q, 1, true) then
            table.insert(out, p)
        end
    end
    return out
end

local function escapeLuaSingle(s)
    s = tostring(s or "")
    s = s:gsub("\\", "\\\\")
    s = s:gsub("'", "\\'")
    s = s:gsub("\r", "")
    s = s:gsub("\n", "\\n")
    return s
end

