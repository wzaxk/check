local function hopToServer(targetPlaceId, targetJobId)
    if not targetJobId or targetJobId == "" then return end
    local pid = tonumber(targetPlaceId)
    if not pid or pid <= 0 then pid = game.PlaceId end
    local ok = pcall(function() TeleportService:TeleportToPlaceInstance(pid, targetJobId, player) end)
