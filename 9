    local ok = pcall(function() TeleportService:TeleportToPlaceInstance(pid, targetJobId, player) end)
    if not ok then pcall(function() TeleportService:Teleport(pid, player) end) end
end

local usernameFallbackCache = {}
local usernameFetching = {}
local allDropdowns = {}

local function resolveUserNames(p)
    local uid = tonumber(p.userId)

    if uid then
        local lp = Players:GetPlayerByUserId(uid)
        if lp then
            return lp.Name, lp.DisplayName or lp.Name
        end
    end

    local uname = p.username or p.user_name
    if (not uname or uname == "") and uid then
        uname = usernameFallbackCache[uid]
        if not uname and not usernameFetching[uid] then
            usernameFetching[uid] = true
            task.spawn(function()
                local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(uid) end)
                usernameFetching[uid] = nil
                if ok and n then
                    usernameFallbackCache[uid] = n
                    for _, dd in ipairs(allDropdowns) do
                        if dd.refreshPlaceholder then pcall(dd.refreshPlaceholder) end
                    end
                end
            end)
        end
    end

    local dname = p.displayName or p.display_name
    if not dname or dname == "" then
        local pn = p.name
        if pn and pn ~= "" and pn ~= uname then
            dname = pn
        end
    end

    if not uname or uname == "" then uname = p.name end
    if not uname or uname == "" then uname = "?" end
    if not dname or dname == "" then dname = uname end

    return uname, dname
end

local function buildUserLabel(p)
    local uname, dname = resolveUserNames(p)
    local parts = { uname }
    if dname and dname ~= "" and dname ~= uname then
        table.insert(parts, dname)
    end
    table.insert(parts, p.gameName or "?")
    return table.concat(parts, " | ")
end

local function fitText(text, maxW, textSize, font)
    if maxW <= 0 or #text == 0 then return text end
    local ok, fullSize = pcall(function()
        return TextService:GetTextSize(text, textSize, font, Vector2.new(10000, 1000))
    end)
    if not ok then return text end
    if fullSize.X <= maxW then return text end
    local lo, hi = 0, #text
    while lo < hi do
        local mid = math.ceil((lo + hi) / 2)
        local sub = text:sub(1, mid) .. "..."
        local sz = TextService:GetTextSize(sub, textSize, font, Vector2.new(10000, 1000))
        if sz.X <= maxW then lo = mid else hi = mid - 1 end
    end
    if lo == 0 then return "..." end
    return text:sub(1, lo) .. "..."
end

local function aDropdown(parent, placeholder, getOptions, selectionState, onSelectionChanged, prewarm)
    local prewarmCount = prewarm or 60

    local container = aNew("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Color3.fromRGB(25, 18, 24),
        BorderSizePixel = 0,
    }, parent)
    aCorner(container, 6)
    aStroke(container, ADMIN_BORDER, 1, 0.3)

    local box = aNew("TextBox", {
        Size = UDim2.new(1, -44, 1, 0), Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1, Text = "",
        PlaceholderText = placeholder or "",
        PlaceholderColor3 = Color3.fromRGB(120, 90, 110), TextColor3 = ADMIN_WHITE,
        TextSize = 12, Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        ClearTextOnFocus = false, ZIndex = 3,
    }, container)
    pcall(function() box.TextEditable = false end)

    local arrow = aNew("TextButton", {
        Size = UDim2.new(0, 24, 1, 0), Position = UDim2.new(1, -26, 0, 0),
        BackgroundTransparency = 1, Text = "▼",
        TextColor3 = Color3.fromRGB(180, 140, 160),
        TextSize = 16, Font = Enum.Font.GothamBold,
        AutoButtonColor = false, ZIndex = 3, Rotation = 0,
    }, container)

    local listHolder = aNew("Frame", {
        Position = UDim2.new(0, 0, 1, 4),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Color3.fromRGB(18, 12, 16),
        BorderSizePixel = 0, Visible = false,
        ClipsDescendants = true, ZIndex = 20,
    }, container)
    aCorner(listHolder, 6)
    aStroke(listHolder, ADMIN_BORDER, 1, 0)

    local scroll = aNew("ScrollingFrame", {
        Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 4,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ScrollBarImageColor3 = ADMIN_CRIMSON, ZIndex = 21,
    }, listHolder)
    aNew("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

    local buttonPool = {}
    local currentUserByIndex = {}
    local self = { isOpen = false, renderToken = 0 }
    local suppressTextHandler = false
    local lastToggleTime = 0

    local function isSelected(p)
        return p.id and selectionState[p.id] ~= nil
    end

    local function toggleSelection(p)
        if not p.id then return end
        if selectionState[p.id] then
            selectionState[p.id] = nil
        else
            selectionState[p.id] = p
        end
    end

    local function updatePlaceholder()
        local names = {}
        for _, p in pairs(selectionState) do
            local uname = resolveUserNames(p)
            table.insert(names, uname)
        end
        if #names == 0 then
            box.PlaceholderText = placeholder
            return
        end
        table.sort(names)
        local text = table.concat(names, ", ")
        local maxW = box.AbsoluteSize.X - 8
        if maxW > 0 then
            text = fitText(text, maxW, 12, Enum.Font.Gotham)
        end
        box.PlaceholderText = text
    end

    local function ensureButton(idx)
        local btn = buttonPool[idx]
        if btn and btn.Parent then return btn end
        btn = aNew("TextButton", {
            Size = UDim2.new(1, -4, 0, 24),
            BackgroundColor3 = ADMIN_CRIMSON, BackgroundTransparency = 1,
            BorderSizePixel = 0, Text = "", TextColor3 = ADMIN_WHITE,
            TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false, ZIndex = 22, Visible = false,
        }, scroll)
        aCorner(btn, 4)
        btn.MouseEnter:Connect(function()
            if not btn.Visible or not btn.Parent then return end
            local p = currentUserByIndex[btn.LayoutOrder]
            if p and isSelected(p) then return end
            TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundTransparency = 0.7 }):Play()
        end)
        btn.MouseLeave:Connect(function()
            if not btn.Visible or not btn.Parent then return end
            local p = currentUserByIndex[btn.LayoutOrder]
            if p and isSelected(p) then return end
            TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundTransparency = 1 }):Play()
        end)
        btn.MouseButton1Down:Connect(function()
            if not btn.Visible then return end
            local p = currentUserByIndex[btn.LayoutOrder]
            if not p then return end
            toggleSelection(p)
            updatePlaceholder()
            local sel = isSelected(p)
            btn.Text = "   " .. buildUserLabel(p)
            btn.BackgroundTransparency = sel and 0.5 or 1
            if onSelectionChanged then onSelectionChanged() end
            if self.isOpen then
                task.defer(function()
                    if box.Parent and self.isOpen then
                        pcall(function() box:CaptureFocus() end)
                    end
                end)
            end
        end)
        buttonPool[idx] = btn
        return btn
    end

    local function applyRow(i, p)
        local btn = ensureButton(i)
        local sel = isSelected(p)
        btn.Text = "   " .. buildUserLabel(p)
        btn.BackgroundTransparency = sel and 0.5 or 1
        btn.LayoutOrder = i
        btn.Visible = true
        currentUserByIndex[i] = p
    end

    local function renderList(query, isOpening)
        query = query or ""
        local allOpts = getOptions(query) or {}
        local shown = #allOpts

        self.renderToken = self.renderToken + 1
        local myToken = self.renderToken

        for i = shown + 1, #buttonPool do
            local b = buttonPool[i]
            if b and b.Parent then b.Visible = false end
            currentUserByIndex[i] = nil
        end

        local itemH = 24
        local padding = 2
        local MAX_VISIBLE = 6
        local contentH = shown * itemH + math.max(0, shown - 1) * padding
        local maxContentH = MAX_VISIBLE * itemH + (MAX_VISIBLE - 1) * padding
        local totalH = math.min(contentH, maxContentH) + 6
        scroll.ScrollBarThickness = (contentH > maxContentH) and 4 or 0

        listHolder.Visible = (shown > 0)
        if isOpening then
            listHolder.Size = UDim2.new(1, 0, 0, 0)
            TweenService:Create(listHolder, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, totalH) }):Play()
            TweenService:Create(arrow, TweenInfo.new(0.2), { Rotation = 180 }):Play()
        else
            listHolder.Size = UDim2.new(1, 0, 0, totalH)
        end

        if shown <= 100 then
            for i = 1, shown do
                applyRow(i, allOpts[i])
            end
            return
        end

        task.spawn(function()
            local CHUNK = 100
            for chunkStart = 1, shown, CHUNK do
                if self.renderToken ~= myToken then return end
                if not container.Parent or not self.isOpen then return end
                local chunkEnd = math.min(chunkStart + CHUNK - 1, shown)
                for i = chunkStart, chunkEnd do
                    applyRow(i, allOpts[i])
                end
                if chunkEnd < shown then task.wait() end
            end
        end)
    end

    function self.refreshPlaceholder()
        updatePlaceholder()
        if self.isOpen then renderList(box.Text, false) end
    end

    function self.hitTest(pos)
        if not container.Parent then return false end
        local function inObj(obj)
            if not obj or not obj.Parent then return false end
            local a = obj.AbsolutePosition
            local s = obj.AbsoluteSize
            return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
        end
        return inObj(container) or (listHolder.Visible and inObj(listHolder))
    end

    function self.doClose()
        if not self.isOpen then return end
        self.isOpen = false
        self.renderToken = self.renderToken + 1
        pcall(function() box.TextEditable = false end)
        pcall(function() box:ReleaseFocus() end)
        suppressTextHandler = true
        if box.Text ~= "" then box.Text = "" end
        suppressTextHandler = false
        local tw = TweenService:Create(listHolder, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Size = UDim2.new(1, 0, 0, 0) })
        tw.Completed:Connect(function() listHolder.Visible = false end)
        tw:Play()
        TweenService:Create(arrow, TweenInfo.new(0.2), { Rotation = 0 }):Play()
    end

    function self.doOpen()
        if self.isOpen then return end
        self.isOpen = true
        pcall(function() box.TextEditable = true end)
        suppressTextHandler = true
        if box.Text ~= "" then box.Text = "" end
        suppressTextHandler = false
        renderList("", true)
        task.defer(function()
            if box.Parent and self.isOpen then
                pcall(function() box:CaptureFocus() end)
            end
        end)
    end

    local function toggleSelf()
        local now = os.clock()
        if now - lastToggleTime < 0.2 then return end
        lastToggleTime = now
        if self.isOpen then self.doClose() else self.doOpen() end
    end

    box.Focused:Connect(function()
        if not self.isOpen then
            pcall(function() box:ReleaseFocus() end)
        end
    end)

    box.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
            toggleSelf()
        end
    end)

    arrow.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
            toggleSelf()
        end
    end)

    container.InputBegan:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1
            and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        if listHolder.Visible then
            local a = listHolder.AbsolutePosition
            local s = listHolder.AbsoluteSize
            local px, py = inp.Position.X, inp.Position.Y
            if px >= a.X and px <= a.X + s.X and py >= a.Y and py <= a.Y + s.Y then return end
        end
        toggleSelf()
    end)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        if suppressTextHandler then return end
        if self.isOpen then renderList(box.Text, false) end
    end)

    box:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if next(selectionState) ~= nil then updatePlaceholder() end
    end)

    updatePlaceholder()
    table.insert(allDropdowns, self)

    task.spawn(function()
        task.wait(0.4)
        for i = 1, prewarmCount do
            if not container.Parent then return end
            ensureButton(i)
            if i % 10 == 0 then task.wait() end
        end
    end)

    return box, container, updatePlaceholder, self
end

local panelRef = { sg = nil, main = nil, scale = nil }
local dragConn = nil
local endConn = nil

local function closeAllDropdowns()
    local snapshot = {}
    for _, dd in ipairs(allDropdowns) do
        if dd.isOpen then table.insert(snapshot, dd) end
    end
    for _, dd in ipairs(snapshot) do
        if dd.doClose then dd.doClose() end
    end
end

local function animateClose(afterClose)
    if not panelRef.sg or not panelRef.scale then
        if afterClose then afterClose() end
        return
    end
    closeAllDropdowns()
    local ref = panelRef
    TweenService:Create(ref.scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 }):Play()
    task.delay(0.2, function()
        if ref.sg then ref.sg.Enabled = false end
        if ref.scale and ref.scale.Parent then ref.scale.Scale = 1 end
        if afterClose then pcall(afterClose) end
    end)
end

local function animateOpen()
    if not panelRef.sg or not panelRef.scale or not panelRef.sg.Parent then
        buildAdminPanel()
        return
    end
    panelRef.sg.Enabled = true
    panelRef.scale.Scale = 0
    TweenService:Create(panelRef.scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

UserInputService.InputBegan:Connect(function(inp)
    if not panelRef.sg or not panelRef.sg.Parent then return end
    if not panelRef.sg.Enabled then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    local anyOpen = false
    for _, dd in ipairs(allDropdowns) do
        if dd.isOpen then anyOpen = true; break end
    end
    if not anyOpen then return end
    local pos = Vector2.new(inp.Position.X, inp.Position.Y)
    local inside = false
    for _, dd in ipairs(allDropdowns) do
        if dd.hitTest and dd.hitTest(pos) then inside = true; break end
    end
    if not inside then closeAllDropdowns() end
end)

