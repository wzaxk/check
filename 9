local function aCodeInput(parent, placeholder, defaultHeight, maxHeight)
    defaultHeight = defaultHeight or 34
    maxHeight = maxHeight or 110

    local f = aNew("Frame", {
        Size = UDim2.new(1, 0, 0, defaultHeight),
        BackgroundColor3 = Color3.fromRGB(25, 18, 24),
        BorderSizePixel = 0, ClipsDescendants = true,
    }, parent)
    aCorner(f, 6)
    aStroke(f, ADMIN_BORDER, 1, 0.3)

    local scroll = aNew("ScrollingFrame", {
        Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ScrollBarImageColor3 = ADMIN_CRIMSON,
    }, f)

    local box = aNew("TextBox", {
        Size = UDim2.new(1, 0, 0, defaultHeight - 8),
        BackgroundTransparency = 1, Text = "",
        PlaceholderText = placeholder or "",
        PlaceholderColor3 = Color3.fromRGB(120, 90, 110),
        TextColor3 = ADMIN_WHITE, TextSize = 12, Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ClearTextOnFocus = false, MultiLine = true, TextWrapped = true,
    }, scroll)

    local function updateHeight()
        if not box.Parent then return end
        local text = box.Text or ""
        local lines = 1
        for _ in text:gmatch("\n") do lines = lines + 1 end
        
        box.TextYAlignment = (lines > 1) and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
        
        local lineH = 16
        local fromLines = lines * lineH + 16
        local fromBounds = box.TextBounds.Y + 16
        local needed = math.max(fromLines, fromBounds, defaultHeight - 8)
        
        box.Size = UDim2.new(1, 0, 0, needed)
        local frameH = math.clamp(needed + 8, defaultHeight, maxHeight)
        f.Size = UDim2.new(1, 0, 0, frameH)
    end

    box:GetPropertyChangedSignal("Text"):Connect(updateHeight)
    box:GetPropertyChangedSignal("TextBounds"):Connect(updateHeight)

    return box, f
end

local function adminHttpGet(url)
    if not httpRequest then return nil end
    local ok, result = pcall(httpRequest, { Url = url, Method = "GET", Headers = { ["User-Agent"] = "Roblox/WinInet" } })
    if not ok or not result or not result.Body then return nil end
    local okD, d = pcall(HttpService.JSONDecode, HttpService, result.Body)
    if okD then return d end
    return nil
end
local function adminHttpPost(url, body)
    if not httpRequest then return nil end
    local ok, result = pcall(httpRequest, {
        Url = url, Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
        Body = HttpService:JSONEncode(body),
    })
    if not ok or not result or not result.Body then return nil end
    local okD, d = pcall(HttpService.JSONDecode, HttpService, result.Body)
    if okD then return d end
    return nil
end

local function dedupePlayers(list)
    local seen, out = {}, {}
    for _, p in ipairs(list or {}) do
        local key = p.id or (tostring(p.jobId or "") .. ":" .. tostring(p.userId or ""))
        if key and key ~= "" and key ~= ":" and not seen[key] then
            seen[key] = true
            table.insert(out, p)
        end
    end
    return out
end

local usersCache = { list = {}, at = 0, fetching = false }
local USERS_TTL = 10

local function getUsersCached()
    local now = os.clock()
    if usersCache.at == 0 then
        if usersCache.fetching then
            while usersCache.fetching do task.wait(0.05) end
            return usersCache.list
        end
        usersCache.fetching = true
        local data = adminHttpGet(SERVER_URL .. "/all?hwid=" .. currentHwid())
        usersCache.list = dedupePlayers((data and data.players) or {})
        usersCache.at = os.clock()
        usersCache.fetching = false
        return usersCache.list
    end
    if now - usersCache.at >= USERS_TTL and not usersCache.fetching then
        usersCache.fetching = true
        task.spawn(function()
            local data = adminHttpGet(SERVER_URL .. "/all?hwid=" .. currentHwid())
            if data and data.players then
                usersCache.list = dedupePlayers(data.players)
                usersCache.at = os.clock()
            end
            usersCache.fetching = false
        end)
    end
    return usersCache.list
end

local function getUsersFresh()
    local data = adminHttpGet(SERVER_URL .. "/all?hwid=" .. currentHwid())
    if data and data.players then
        usersCache.list = dedupePlayers(data.players)
        usersCache.at = os.clock()
    end
    return usersCache.list
end

