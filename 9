local function getSafeGuiParent()
    local hidden
    pcall(function()
        if typeof(gethui) == "function" then hidden = gethui() end
    end)
    if typeof(hidden) == "Instance" then return hidden end
    local core
    pcall(function()
        local cg = game:GetService("CoreGui")
        local probe = Instance.new("Folder")
        probe.Parent = cg
        probe:Destroy()
        core = cg
    end)
    if core then return core end
    return player:WaitForChild("PlayerGui")
end

