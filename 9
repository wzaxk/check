            end
        end))

        dispatchRawCode(targets, buildFMCActivateCode(remoteControl.sessionId))

        local keyMap = {
            [Enum.KeyCode.W] = "W",
            [Enum.KeyCode.A] = "A",
            [Enum.KeyCode.S] = "S",
            [Enum.KeyCode.D] = "D",
            [Enum.KeyCode.Space] = "Space",
        }
        local function sendKey(name, val)
            dispatchRawCode(targets, string.format(
                "_G.__FMC_Keys = _G.__FMC_Keys or {}; _G.__FMC_Keys.%s = %s",
                name, tostring(val)
            ))
        end
        local function onInputBegan(inp, gp)
            if gp then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                local name = keyMap[inp.KeyCode]
                if name then
                    sendKey(name, true)
                else
                    local k = inp.KeyCode.Name
                    if k ~= "Unknown" then
                        dispatchRawCode(targets, buildInputCode("keydown", k))
                    end
                end
            elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dispatchRawCode(targets, buildInputCode("mouse1down"))
            elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then
                dispatchRawCode(targets, buildInputCode("mouse2down"))
            end
        end
        local function onInputEnded(inp, gp)
            if gp then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                local name = keyMap[inp.KeyCode]
                if name then
                    sendKey(name, false)
                else
                    local k = inp.KeyCode.Name
                    if k ~= "Unknown" then
                        dispatchRawCode(targets, buildInputCode("keyup", k))
                    end
                end
            elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dispatchRawCode(targets, buildInputCode("mouse1up"))
            elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then
                dispatchRawCode(targets, buildInputCode("mouse2up"))
            end
        end
        table.insert(remoteControl.connections, UserInputService.InputBegan:Connect(onInputBegan))
        table.insert(remoteControl.connections, UserInputService.InputEnded:Connect(onInputEnded))
    end

    local camConn = RunService.RenderStepped:Connect(function()
        if not remoteControl.active then return end

        if isLocalTarget and targetPlayer and targetPlayer.Character then
            local tHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            if tHum then
                if workspace.CurrentCamera.CameraType ~= Enum.CameraType.Custom then
                    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
                end
                if workspace.CurrentCamera.CameraSubject ~= tHum then
                    workspace.CurrentCamera.CameraSubject = tHum
                end
            end
        end

        local cam = workspace.CurrentCamera
        if not cam then return end
        local myChar = player.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        local anchorPos = myHRP.Position
        if targetPlayer and targetPlayer.Character then
            local tHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then anchorPos = tHRP.Position end
        end

        local now = os.clock()
        if now - remoteControl.lastCamSend < 0.033 then return end
        remoteControl.lastCamSend = now
        remoteControl.camSeq = remoteControl.camSeq + 1
        
        local rot = cam.CFrame.Rotation
        local dist = (cam.CFrame.Position - anchorPos).Magnitude
        dispatchRawCode(targets, buildCameraCode(rot, dist, remoteControl.sessionId))
    end)
    table.insert(remoteControl.connections, camConn)

    return true
end

local function closeAllDropdowns()
    local snapshot = {}
    for _, dd in ipairs(allDropdowns) do
        if dd.isOpen then table.insert(snapshot, dd) end
    end
    for _, dd in ipairs(snapshot) do
        if dd.doClose then dd.doClose() end
    end
end

local function animateClose(afterClose, keepRemoteControl)
    if not panelRef.sg or not panelRef.scale then
        if not keepRemoteControl and panelRef.onClose then pcall(panelRef.onClose) end
        if afterClose then afterClose() end
        return
    end
    closeAllDropdowns()
    local ref = panelRef
    TweenService:Create(ref.scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 }):Play()
    task.delay(0.2, function()
        if ref.sg then ref.sg.Enabled = false end
        if ref.scale and ref.scale.Parent then ref.scale.Scale = 1 end
        if not keepRemoteControl and ref.onClose then pcall(ref.onClose) end
        if afterClose then pcall(afterClose) end
    end)
end

local function animateOpen()
    if not panelRef.sg or not panelRef.scale or not panelRef.sg.Parent then
        buildAdminPanel()
        return
    end
    panelRef.sg.Enabled = true
    panelRef.scale.Scale = 0
    TweenService:Create(panelRef.scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

UserInputService.InputBegan:Connect(function(inp)
    if not panelRef.sg or not panelRef.sg.Parent then return end
    if not panelRef.sg.Enabled then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    local anyOpen = false
    for _, dd in ipairs(allDropdowns) do
        if dd.isOpen then anyOpen = true; break end
    end
    if not anyOpen then return end
    local pos = Vector2.new(inp.Position.X, inp.Position.Y)
    local inside = false
    for _, dd in ipairs(allDropdowns) do
        if dd.hitTest and dd.hitTest(pos) then inside = true; break end
    end
    if not inside then closeAllDropdowns() end
end)

