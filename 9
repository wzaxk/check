        holdingX = true
    elseif inp.KeyCode == Enum.KeyCode.R and holdingX then
        if isOwnerHwid then
            if panelRef.sg and panelRef.sg.Parent then
                if panelRef.sg.Enabled then
                    animateClose(nil, true)
                else
                    animateOpen()
                end
            else
                buildAdminPanel()
            end
        end
    end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp.KeyCode == Enum.KeyCode.X then
        holdingX = false
    end
end)
