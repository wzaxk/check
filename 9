local function filterUsers(query, source)
    local list = getUsersCached()
    if source == "server" then
        local myJob = game.JobId
        local filtered = {}
        for _, p in ipairs(list) do
            local pid = tostring(p.id or "")
            local pJob = pid:match("^([^:]+)") or tostring(p.jobId or "")
            if pJob == myJob then table.insert(filtered, p) end
        end
        list = filtered
    end
    local q = string.lower(query or "")
    if q == "" then return list end
    local out = {}
    for _, p in ipairs(list) do
        local n  = string.lower(tostring(p.name or ""))
        local un = string.lower(tostring(p.username or ""))
        local d  = string.lower(tostring(p.displayName or ""))
        local u  = string.lower(tostring(p.userId or ""))
        if string.find(n, q, 1, true) or string.find(un, q, 1, true)
            or string.find(d, q, 1, true) or string.find(u, q, 1, true) then
            table.insert(out, p)
        end
    end
    return out
end

local function dispatchCommand(targets, cmdType, payload)
    local body = {
        hwid = currentHwid(), type = cmdType, payload = payload or {},
        gameId = gameIdStr, placeId = placeIdStr,
    }
    if targets == nil then
        local freshList = getUsersFresh()
        local ids = {}
        for _, p in ipairs(freshList) do
            if p.id and p.id ~= clientId then
                table.insert(ids, p.id)
            end
        end
        if #ids == 0 then
            return nil
        end
        body.targets = ids
        body.all = false
    else
        body.targets = targets
        body.all = false
        if #targets == 0 then return nil end
    end
    local res = adminHttpPost(SERVER_URL .. "/cmd", body)
    return res
end

