local function aNew(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end
local function aCorner(inst, r)
    return aNew("UICorner", { CornerRadius = UDim.new(0, r or 6) }, inst)
end
local function aStroke(inst, col, th, tr)
    return aNew("UIStroke", { Color = col or ADMIN_BORDER, Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, inst)
end
local function aLabel(parent, text, size, color, font)
    return aNew("TextLabel", {
        BackgroundTransparency = 1, Size = size, Text = text,
        TextColor3 = color or ADMIN_WHITE, TextSize = 12,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

local function aButton(parent, text, size, color, callback)
    local baseColor = color or ADMIN_CRIMSON
    local b = aNew("TextButton", {
        Size = size, BackgroundColor3 = baseColor, BorderSizePixel = 0,
        Text = text, TextColor3 = ADMIN_WHITE, TextSize = 12,
        Font = Enum.Font.GothamBold, AutoButtonColor = false,
    }, parent)
    aCorner(b, 6)
    local hover = baseColor:Lerp(Color3.fromRGB(255, 255, 255), 0.15)
    local press = baseColor:Lerp(Color3.fromRGB(0, 0, 0), 0.15)
    b.MouseEnter:Connect(function()
        if b.Parent then TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = hover }):Play() end
    end)
    b.MouseLeave:Connect(function()
        if b.Parent then TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = baseColor }):Play() end
    end)
    b.MouseButton1Down:Connect(function()
        if b.Parent then TweenService:Create(b, TweenInfo.new(0.08), { BackgroundColor3 = press }):Play() end
    end)
    b.MouseButton1Up:Connect(function()
        if b.Parent then TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = hover }):Play() end
    end)
    if callback then b.MouseButton1Click:Connect(callback) end
    return b
end

