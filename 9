local function resolveUserNames(p)
    local uid = tonumber(p.userId)

    if uid then
        local lp = Players:GetPlayerByUserId(uid)
        if lp then
            return lp.Name, lp.DisplayName or lp.Name
        end

        local cached = usernameFallbackCache[uid]
        if cached then
            local dname = p.displayName or p.display_name or p.name
            if not dname or dname == "" then dname = cached end
            return cached, dname
        end

        if not usernameFetching[uid] then
            usernameFetching[uid] = true
            task.spawn(function()
                local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(uid) end)
                usernameFetching[uid] = nil
                if ok and n then
                    usernameFallbackCache[uid] = n
                    notifyDropdowns()
                end
            end)
        end
    end

    local uname = p.username or p.user_name or p.name
    if not uname or uname == "" then uname = "?" end
    local dname = p.displayName or p.display_name
    if not dname or dname == "" then dname = p.name end
    if not dname or dname == "" then dname = uname end

    return uname, dname
end

local function buildUserLabel(p)
    local uname, dname = resolveUserNames(p)
    local parts = { uname }
    if dname and dname ~= "" and dname ~= uname then
        table.insert(parts, dname)
    end
    table.insert(parts, p.gameName or "?")
    return table.concat(parts, " | ")
end

local function fitText(text, maxW, textSize, font)
    if maxW <= 0 or #text == 0 then return text end
    local ok, fullSize = pcall(function()
        return TextService:GetTextSize(text, textSize, font, Vector2.new(10000, 1000))
    end)
    if not ok then return text end
    if fullSize.X <= maxW then return text end
    local lo, hi = 0, #text
    while lo < hi do
        local mid = math.ceil((lo + hi) / 2)
        local sub = text:sub(1, mid) .. "..."
        local sz = TextService:GetTextSize(sub, textSize, font, Vector2.new(10000, 1000))
        if sz.X <= maxW then lo = mid else hi = mid - 1 end
    end
    if lo == 0 then return "..." end
    return text:sub(1, lo) .. "..."
end

