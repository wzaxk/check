local function buildFMCActivateCode(sessionId)
    return string.format([==[
local plr = game:GetService("Players").LocalPlayer
if not plr then return end

pcall(function()
    local pm = plr:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
    if pm then pm:GetControls():Disable() end
end)

_G.__FMC_Keys = _G.__FMC_Keys or {}
_G.__FMC_Active = true
_G.__FMC_CamRot = nil
_G.__FMC_CamDist = nil
_G.__FMC_CamRotCurrent = nil
_G.__FMC_CamDistCurrent = nil
_G.__FMC_Anchor = nil
_G.__FMC_SessionId = '%s'

if _G.__FMC_LoopConn then pcall(function() _G.__FMC_LoopConn:Disconnect() end) end

local RS = game:GetService("RunService")
_G.__FMC_LoopConn = RS.RenderStepped:Connect(function(dt)
    if not _G.__FMC_Active then return end
    local char = plr.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")

    local keys = _G.__FMC_Keys or {}
    local kx, kz = 0, 0
    if keys.W then kz = kz - 1 end
    if keys.S then kz = kz + 1 end
    if keys.A then kx = kx - 1 end
    if keys.D then kx = kx + 1 end

    local cam = workspace.CurrentCamera
    local camCF = cam and cam.CFrame or CFrame.new()
    local fwd = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
    local rgt = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
    if fwd.Magnitude > 0.001 then fwd = fwd.Unit else fwd = Vector3.new(0, 0, -1) end
    if rgt.Magnitude > 0.001 then rgt = rgt.Unit else rgt = Vector3.new(1, 0, 0) end

    local dir = fwd * (-kz) + rgt * kx
    if dir.Magnitude > 0.01 then
        hum:Move(dir.Unit, false)
    else
        hum:Move(Vector3.new(0, 0, 0), false)
    end

    if keys.Space then
        hum.Jump = true
    end

    if hrp and cam then
        local rot = _G.__FMC_CamRot
        local dist = _G.__FMC_CamDist
        if rot and dist then
            local anchor = _G.__FMC_Anchor
            if not anchor then
                anchor = hrp.Position
            else
                anchor = anchor:Lerp(hrp.Position, math.clamp(dt * 12, 0, 1))
            end
            _G.__FMC_Anchor = anchor

            local currentRot = _G.__FMC_CamRotCurrent
            if not currentRot then
                currentRot = rot
            else
                currentRot = currentRot:Lerp(rot, math.clamp(dt * 12, 0, 1))
            end
            _G.__FMC_CamRotCurrent = currentRot

            local curDist = _G.__FMC_CamDistCurrent
            if not curDist then
                curDist = dist
            else
                curDist = curDist + (dist - curDist) * math.clamp(dt * 12, 0, 1)
            end
            _G.__FMC_CamDistCurrent = curDist

            cam.CameraType = Enum.CameraType.Scriptable
            local camPos = anchor - currentRot.LookVector * curDist
            cam.CFrame = CFrame.new(camPos) * currentRot
        end
    end
end)
]==], sessionId or "")
end

